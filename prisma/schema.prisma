generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserStatus { ACTIVE INACTIVE SUSPENDED PENDING }
enum AppRole { ADMIN SUPERVISOR }
enum AssignmentStatus { ACTIVE ENDED SUSPENDED }
enum VisitRecurrenceFrequency { ONCE WEEKLY BIWEEKLY MONTHLY }
enum VisitStatus { SCHEDULED IN_PROGRESS COMPLETED CANCELLED RESCHEDULED }
enum AnswerCondition { OPTIMAL REGULAR BAD NOT_APPLICABLE }
enum InspectionStatus { NOT_STARTED IN_PROGRESS COMPLETED }
enum Priority { LOW MEDIUM HIGH CRITICAL }
enum IncidentStatus { OPEN ASSIGNED IN_PROGRESS PENDING_VERIFICATION RESOLVED CLOSED }
enum IncidentUpdateType { CREATED COMMENT ASSIGNED STATUS_CHANGED WORK_COMPLETED VERIFIED CORRECTION_REQUIRED INTERNAL_NOTE }
enum IncidentPhotoType { BEFORE AFTER GENERAL }
enum StockStatus { AVAILABLE LOW_STOCK OUT_OF_STOCK NOT_VERIFIED }
enum RequestStatus { DRAFT SUBMITTED UNDER_REVIEW APPROVED REJECTED PURCHASED DELIVERED }
enum TowerStatus { ACTIVE OBSERVATION MAINTENANCE INACTIVE }
enum TowerType { TOWER CONDOMINIUM RESIDENTIAL }

model Role { id String @id @default(cuid()) name String @unique permissions Json users UserRole[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model User { id String @id @default(cuid()) firebaseUid String? @unique firstName String lastName String email String @unique phone String? avatarUrl String? jobTitle String? appRole AppRole status UserStatus @default(PENDING) notes String? lastLoginAt DateTime? passwordHash String? roles UserRole[] supervisor Supervisor? assignmentsCreated TowerAssignment[] @relation("AssignedBy") assignmentsEnded TowerAssignment[] @relation("EndedBy") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model UserRole { userId String roleId String user User @relation(fields:[userId],references:[id]) role Role @relation(fields:[roleId],references:[id]) @@id([userId,roleId]) }
model Supervisor { id String @id @default(cuid()) userId String @unique employeeCode String? phone String? user User @relation(fields:[userId],references:[id]) assignments TowerAssignment[] visits Visit[] incidents Incident[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Tower { id String @id @default(cuid()) code String @unique name String type TowerType @default(TOWER) address String sector String? city String? province String? locationReference String? floors Int? apartments Int? parkingSpaces Int? elevators Int? yearBuilt Int? blocks Int? hasPool Boolean @default(false) hasGym Boolean @default(false) hasSocialArea Boolean @default(false) hasGenerator Boolean @default(false) hasElevators Boolean @default(false) hasCameras Boolean @default(false) hasWaterTank Boolean @default(false) hasPumps Boolean @default(false) status TowerStatus @default(ACTIVE) notes String? contacts TowerContact[] assignments TowerAssignment[] visits Visit[] incidents Incident[] inventory TowerInventory[] materialRequests MaterialRequest[] documents Document[] photos TowerPhoto[] activity ActivityLog[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TowerContact { id String @id @default(cuid()) towerId String type String name String phone String? email String? notes String? tower Tower @relation(fields:[towerId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([towerId]) }
model TowerPhoto { id String @id @default(cuid()) towerId String url String storageKey String? origin String supervisorId String? tower Tower @relation(fields:[towerId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([towerId,createdAt]) }
model TowerAssignment { id String @id @default(cuid()) towerId String supervisorId String assignedById String status AssignmentStatus @default(ACTIVE) startDate DateTime endDate DateTime? endedById String? notes String? tower Tower @relation(fields:[towerId],references:[id]) supervisor Supervisor @relation(fields:[supervisorId],references:[id]) assignedBy User @relation("AssignedBy",fields:[assignedById],references:[id]) endedBy User? @relation("EndedBy",fields:[endedById],references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([towerId,supervisorId,status]) }
model Visit { id String @id @default(cuid()) code String @unique towerId String supervisorId String checklistTemplateId String? status VisitStatus @default(SCHEDULED) scheduledDate DateTime scheduledTime String estimatedDuration Int @default(60) visitType String notes String? priority Priority? startedAt DateTime? startedBy String? completedAt DateTime? completedBy String? cancelledAt DateTime? cancelledById String? cancellationReason String? createdById String tower Tower @relation(fields:[towerId],references:[id]) supervisor Supervisor @relation(fields:[supervisorId],references:[id]) inspections Inspection[] incidents Incident[] materialRequests MaterialRequest[] scheduleHistory VisitScheduleHistory[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([supervisorId,scheduledDate]) }
model VisitScheduleHistory { id String @id @default(cuid()) visitId String previousDate DateTime? previousTime String? newDate DateTime newTime String reason String changedById String visit Visit @relation(fields:[visitId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([visitId,createdAt]) }
model VisitRecurrence { id String @id @default(cuid()) towerId String supervisorId String checklistTemplateId String? frequency VisitRecurrenceFrequency startDate DateTime endDate DateTime? scheduledTime String dayOfWeek Int? active Boolean @default(true) createdById String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([supervisorId,active]) }
model ChecklistTemplate { id String @id @default(cuid()) name String version Int @default(1) isActive Boolean @default(true) sections ChecklistSection[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ChecklistSection { id String @id @default(cuid()) templateId String title String position Int template ChecklistTemplate @relation(fields:[templateId],references:[id]) items ChecklistItem[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([templateId,position]) }
model ChecklistItem { id String @id @default(cuid()) sectionId String title String instructions String? position Int requiresInventoryCheck Boolean @default(false) section ChecklistSection @relation(fields:[sectionId],references:[id]) answers InspectionAnswer[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([sectionId,position]) }
model Inspection { id String @id @default(cuid()) visitId String templateId String? progress Int @default(0) status InspectionStatus @default(NOT_STARTED) startedAt DateTime? completedAt DateTime? overallCondition AnswerCondition? visit Visit @relation(fields:[visitId],references:[id]) answers InspectionAnswer[] photos InspectionPhoto[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model InspectionAnswer { id String @id @default(cuid()) inspectionId String itemId String condition AnswerCondition observation String? responsible String? materialNeeded String? priority Priority? inspection Inspection @relation(fields:[inspectionId],references:[id]) item ChecklistItem @relation(fields:[itemId],references:[id]) photos InspectionPhoto[] incident Incident? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([inspectionId,itemId]) }
model InspectionPhoto { id String @id @default(cuid()) inspectionId String answerId String? url String storageKey String? mimeType String? latitude Decimal? @db.Decimal(10,7) longitude Decimal? @db.Decimal(10,7) inspection Inspection @relation(fields:[inspectionId],references:[id]) answer InspectionAnswer? @relation(fields:[answerId],references:[id]) createdAt DateTime @default(now()) }
model Incident { id String @id @default(cuid()) code String @unique towerId String visitId String? inspectionId String? answerId String? supervisorId String? reportedById String assignedToId String? assigneeType String? area String category String title String description String observation String? priority Priority status IncidentStatus @default(OPEN) responsibleId String? resolvedAt DateTime? closedAt DateTime? tower Tower @relation(fields:[towerId],references:[id]) visit Visit? @relation(fields:[visitId],references:[id]) answer InspectionAnswer? @relation(fields:[answerId],references:[id]) supervisor Supervisor? @relation(fields:[supervisorId],references:[id]) photos IncidentPhoto[] updates IncidentUpdate[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([status,priority]) @@index([towerId,createdAt]) }
model IncidentUpdate { id String @id @default(cuid()) incidentId String userId String type IncidentUpdateType comment String oldStatus IncidentStatus? newStatus IncidentStatus? isInternal Boolean @default(false) incident Incident @relation(fields:[incidentId],references:[id]) photos IncidentPhoto[] createdAt DateTime @default(now()) @@index([incidentId,createdAt]) }
model IncidentPhoto { id String @id @default(cuid()) incidentId String incidentUpdateId String? url String storageKey String? type IncidentPhotoType @default(GENERAL) incident Incident @relation(fields:[incidentId],references:[id]) incidentUpdate IncidentUpdate? @relation(fields:[incidentUpdateId],references:[id]) createdAt DateTime @default(now()) }
model InventoryItem { id String @id @default(cuid()) name String category String unit String? isActive Boolean @default(true) towers TowerInventory[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TowerInventory { id String @id @default(cuid()) towerId String itemId String quantity Decimal @default(0) recommendedQuantity Decimal? location String? observation String? stockStatus StockStatus @default(NOT_VERIFIED) lastCheckedById String? lastCheckedAt DateTime? tower Tower @relation(fields:[towerId],references:[id]) item InventoryItem @relation(fields:[itemId],references:[id]) photos InventoryPhoto[] updatedAt DateTime @updatedAt @@unique([towerId,itemId]) }
model InventoryPhoto { id String @id @default(cuid()) towerInventoryId String storageKey String latitude Decimal? longitude Decimal? towerInventory TowerInventory @relation(fields:[towerInventoryId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) }
model MaterialRequest { id String @id @default(cuid()) code String @unique visitId String? towerId String requestedById String status RequestStatus @default(DRAFT) notes String? rejectionReason String? visit Visit? @relation(fields:[visitId],references:[id]) tower Tower @relation(fields:[towerId],references:[id]) items MaterialRequestItem[] updates MaterialRequestUpdate[] purchaseRequest PurchaseRequest? approvedAt DateTime? purchasedAt DateTime? deliveredAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model MaterialRequestItem { id String @id @default(cuid()) requestId String inventoryItemId String currentQuantity Decimal @default(0) quantity Decimal observation String? request MaterialRequest @relation(fields:[requestId],references:[id],onDelete:Cascade) }
model MaterialRequestUpdate { id String @id @default(cuid()) requestId String userId String oldStatus RequestStatus? newStatus RequestStatus comment String? request MaterialRequest @relation(fields:[requestId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) }
model PurchaseRequest { id String @id @default(cuid()) materialRequestId String @unique status RequestStatus @default(SUBMITTED) approvedById String? orderedAt DateTime? receivedAt DateTime? materialRequest MaterialRequest @relation(fields:[materialRequestId],references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Document { id String @id @default(cuid()) towerId String? name String storageKey String mimeType String? tower Tower? @relation(fields:[towerId],references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Report { id String @id @default(cuid()) type String towerId String? visitId String? generatedById String periodStart DateTime periodEnd DateTime createdAt DateTime @default(now()) @@index([towerId,createdAt]) }
model Notification { id String @id @default(cuid()) userId String title String body String readAt DateTime? createdAt DateTime @default(now()) @@index([userId,readAt]) }
model ActivityLog { id String @id @default(cuid()) userId String? towerId String? action String entityType String entityId String metadata Json? tower Tower? @relation(fields:[towerId],references:[id]) createdAt DateTime @default(now()) @@index([entityType,entityId,createdAt]) @@index([towerId,createdAt]) }
